# Copy this file to .env and fill in your values. The bot reads this file.

# 1) Get this from @BotFather on Telegram: send /newbot and copy the token.
BOT_TOKEN=

# 2) Your Telegram numeric chat ID(s), comma-separated for multiple.
#    Leave empty while testing. Message the bot /start and it prints YOUR chat
#    ID that you should paste here to lock the bot to yourself.
CHAT_IDS=

# Path to the jobs database (relative to the folder you run the bot from).
JOB_DB_PATH=jobs_database.json
STATE_FILE=telegram_bot_state.json

# How often (minutes) to scan the database for newly added matching jobs.
CHECK_INTERVAL_MINUTES=10

# Daily digest time in 24h format (your local time, e.g. 08:00).
DIGEST_TIME=08:00

# Timezone. Simplest: leave TZ empty and set TZ_OFFSET_MINUTES to your UTC
# offset (India = +5:30 = 330). For full names like Asia/Kolkata, set TZ and
# TZ_OFFSET_MINUTES is ignored.
TZ=
TZ_OFFSET_MINUTES=330

# Your target profile.
USER_AGE_MIN=25
USER_AGE_MAX=30
USER_BRANCHES=it

# Auto-scraping of govt job aggregator pages (SarkariResult Latest Job).
# The bot scans these every SCRAPE_INTERVAL_HOURS (via Render keep-alive) and
# pushes new B.E.-IT / graduate / no-GATE candidates with deadline + link.
AUTO_SCRAPE_ENABLED=true
SCRAPE_INTERVAL_HOURS=6
# Comma-separated list of 'Latest Job' aggregator pages to scan.
SCRAPE_SOURCES=https://www.sarkariresult.com/latestjob/

# Port for the health endpoint (keeps free hosts awake via uptime pings).
PORT=8080
